@startuml
title CotizaTech - Diagrama UML de Componentes
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam packageStyle rectangle

package "Frontend - React 19 + Vite (cotizatech/src)" {
  component "Páginas Comprador\n(Dashboard, Catalogo, Cotizaciones,\nCotizacionDetalle, Perfil)" as PagComprador
  component "Páginas Asesor\n(PanelAsesor, BandejaSolicitudes,\nEditorCotizacion, Clientes, Reportes)" as PagAsesor
  component "AuthContext\n(sesión)" as AuthCtx
  component "CotizacionesContext\n(carrito, avisos)" as CotCtx
  component "useApi\n(carga y errores)" as UseApi
  component "Cliente API\n(src/api/*.js · fetch)" as ClienteApi
  component "Exportación PDF\n(window.print)" as PDF
}

package "Backend - Node.js + Express 5 (cotizatech/server)" {
  component "Middleware\n(autenticar JWT, requerirRol,\nmanejarErrores, helmet)" as Middleware
  component "Rutas\n(auth, productos, carrito,\ncotizaciones, asesor)" as Rutas
  component "CotizacionFacade\n<<Facade>>" as Facade

  package "Dominio (patrones GoF)" {
    component "EstadoCotizacion\n<<State>>" as State
    component "CalculadoraCotizacion\n<<Strategy>>" as Strategy
    component "PublicadorEventos\n+ observadores\n<<Observer>>" as Observer
    component "DocumentoCotizacionBuilder\n<<Builder>>" as Builder
  }
  component "db.js\n(node:sqlite)" as DbJs
}

database "SQLite\ncotizatech.db\n(tablas, vistas, triggers)" as BD
component "Correo\n(simulado en el MVP)" as Correo #FFF3DB

interface "API REST /api (JSON)" as REST

PagComprador --> CotCtx
PagComprador --> UseApi
PagComprador --> PDF
PagAsesor --> UseApi
PagAsesor --> PDF
PagComprador --> AuthCtx
PagAsesor --> AuthCtx
AuthCtx --> ClienteApi
CotCtx --> ClienteApi
UseApi --> ClienteApi
ClienteApi -( REST : requiere\n(HTTP + cookie JWT)
REST - Middleware : provee
Middleware --> Rutas
Rutas --> Facade : cotizaciones
Rutas --> DbJs : auth, catálogo, carrito
Facade --> State : ¿acción permitida?
Facade --> Strategy : totales, IVA, tope 15%
Facade --> Observer : publica cambio de estado
Facade --> Builder : documento para el cliente
Facade --> DbJs
Observer --> DbJs : historial
Observer ..> Correo : aviso (simulado)
DbJs --> BD : SQL

note bottom of Correo
  Proyectado: envío real de correo
  (fuera del alcance del MVP, Entregable 2).
end note
@enduml
